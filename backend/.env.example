# Shelf2Cash backend environment (template)
# Copy to backend/.env and fill in real values. Never commit real secrets.

# MongoDB connection (local instance or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/shelf2cash
PORT=5000
NODE_ENV=development

# Python ML microservice
ML_SERVICE_URL=http://localhost:8000

# Optional external integrations (mock fallbacks work without these)
OPENWEATHER_API_KEY=
DATA_GOV_API_KEY=
DEMO_MERCHANT_ID=m_demo
MESH_SCAN_INTERVAL_MS=30000

# Optional WhatsApp integration
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
